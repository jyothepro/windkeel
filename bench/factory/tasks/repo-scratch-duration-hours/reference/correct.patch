 export function parseDuration(text) {
-  const match = /^(?:(\d+)m )?(\d+)s$/.exec(String(text).trim());
+  const match = /^(?:(\d+)h )?(?:(\d+)m )?(\d+)s$/.exec(String(text).trim());
