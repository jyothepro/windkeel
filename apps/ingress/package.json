    "build:vercel": "node build-vercel-output.mjs"
  },
  "dependencies": {
    "@windkeel/api-contract": "*",
    "@windkeel/factory": "file:../..",
    "@vercel/functions": "^3.10.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@workflow/builders": "^5.0.0-beta.53",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3"
  }
