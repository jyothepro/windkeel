{
  "name": "@windkeel/console",
  "version": "0.2.0",
  "description": "The Windkeel console (the Product UI milestone): a reader of the control plane API. It calls /v1 from its own server, so the browser never holds the token.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "prebuild": "npm run build -w @windkeel/api-contract",
    "build": "next build",
    "start": "next start --port 3100",
    "pretypecheck": "npm run build -w @windkeel/api-contract",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/*.test.ts",
    "api:local": "node scripts/local-api.mjs"
  },
  "dependencies": {
    "@windkeel/api-contract": "*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.9.3"
  }
}
