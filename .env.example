# Local dev (`docker compose up`) connection info — see ADR-0016. Copy to `.env` and load
# it however your shell/tooling prefers; nothing in this repo reads .env automatically.

# Direct (session-mode) Postgres connection, matching what the worker container uses in
# production (ADR-0008 §1). The `migrate` compose service already uses this value.
DATABASE_URL=postgresql://windkeel:windkeel@localhost:5432/windkeel
# Vercel/serverless query traffic. In Supabase production this is the same shared-pooler URL on
# port 6543 (transaction mode); locally it may be omitted and falls back to DATABASE_URL.
DATABASE_POOL_URL=

# MinIO — the local substitute for Supabase Storage's S3-compatible API (ADR-0008 §2).
# The `minio-init` compose service creates this bucket on boot.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=windkeel
S3_SECRET_ACCESS_KEY=windkeel-local-dev
S3_BUCKET=evidence

# Vercel Sandbox (ADR-0004/0014, Milestone 2). A non-Vercel server authenticates with an
# access token scoped to one team/project (research/vercel-sandbox/findings.md §5).
# Sandbox-backed tests skip cleanly when these are unset, same as TEST_DATABASE_URL.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# The GitHub App (ADR-0009). With these set, every sandbox gets a freshly minted,
# repository-scoped, role-scoped installation token — `contents: write` for the maker,
# `contents: read` for the verifier — so a verifier is *unable* to push rather than merely
# forbidden to (ADR-0014 §2). The private key may be a PEM, a PEM with \n escapes, or base64
# of one.
#
# Both deployables need these. The worker mints the scoped tokens described above; the ingress
# needs the App's identity to answer on the issue (the run-start comment, and the reason a
# labelled-but-closed issue was ignored) — apps/ingress/api/webhook.ts builds its client at
# module scope, so a Vercel project missing either one 500s on every delivery.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional, both deployables. Absent, the installation is discovered per repository (ADR-0001 —
# a single installation). GITHUB_API_BASE_URL defaults to https://api.github.com; set it for
# GitHub Enterprise Server.
GITHUB_APP_INSTALLATION_ID=
GITHUB_API_BASE_URL=
# Verified on every webhook delivery before anything is persisted (ADR-0009 §6). Needed by the
# ingress; the worker never checks a signature.
GITHUB_WEBHOOK_SECRET=

# LOCAL DEVELOPMENT ONLY. A PAT the sandbox clones with when no GitHub App is configured.
# It cannot be scoped per role, so a verifier holding it is only prevented from pushing by the
# static guard in src/sandbox/lifecycle.ts — which is why the production path does not use it.
# Leave empty unless you are deliberately running without an App; the hermetic stack
# (ADR-0016) clones a bare repo from disk and needs no credential at all.
SANDBOX_GIT_TOKEN=

# Authorises /api/sweep, the hourly cron that runs ADR-0015's evidence retention and the #198
# sandbox reaper. The route compares this in constant time and **fails closed when it is unset**,
# so a deployment without it is safe but inert: nothing is ever retained or reaped, and the only
# sign is an hourly 401 in the cron log. Vercel attaches it to its own cron invocations once the
# variable exists; nothing else has to be wired.
CRON_SECRET=

# --- The factory's own configuration (ADR-0020: the deployment, not a container) -----------
# Every variable below is read and validated when configuration loads. A missing required one is
# reported by name — a deployment that accepts a webhook happily and then dies on some later
# run's third stage is much worse than one that refuses.

# The repository runs work against. Container configuration in M4 rather than per-task data:
# EngineeringTask.repository_id is a bare uuid with no repository table behind it yet, and
# ADR-0001 is one operator, one container through M6. M6's GitHub App intake makes it per-task.
WINDKEEL_REPOSITORY_URL=
WINDKEEL_REPOSITORY_BASE_REVISION=HEAD

# ADR-0010 (pre-BYOK): the maker's model, and the vendor the checker must be independent of.
WINDKEEL_MAKER_MODEL=gpt-5-codex
WINDKEEL_MAKER_VENDOR=openai

# ADR-0014 §1: the domain the brokered key is attached to at the egress proxy, and the name of
# the variable *in the container* holding the real key. The key is never injected into a
# sandbox — the sandbox sees CODEX_API_KEY_PLACEHOLDER. Startup fails if the named variable is
# unset, because a broker rule pointing at nothing fails much later and much less clearly.
WINDKEEL_MODEL_API_DOMAIN=api.openai.com
WINDKEEL_MODEL_KEY_ENV_VAR=OPENAI_API_KEY
OPENAI_API_KEY=

# Repository secrets (ADR-0023 §9, ADR-0014 §5). One X25519 pair, split across two processes, so
# that the process accepting a secret is cryptographically unable to read one back. Mint both with
# `windkeel-admin secrets keygen`.
#
#   WINDKEEL_SECRET_PUBLIC_KEY   goes to INGRESS (Vercel). Seals. Cannot open.
#   WINDKEEL_SECRET_PRIVATE_KEY  goes to the STAGE deployment only. Opens. Never on ingress.
#
# Both may be left unset: a factory whose repositories all install from public registries needs
# neither. What must not happen is secrets stored with no private key here — every install then runs
# without them, silently, which is what the `repository-secrets` check in `windkeel-admin doctor` is for.
# Rotating the pair does not re-seal what is stored. During a rotation, put the old private half in
# WINDKEEL_SECRET_PREVIOUS_PRIVATE_KEY (stage deployment only) so values sealed to it keep opening until
# they are set again (ADR-0026 §2). Repository secrets and model credentials both use this pair.
WINDKEEL_SECRET_PRIVATE_KEY=
WINDKEEL_SECRET_PREVIOUS_PRIVATE_KEY=

# Development only: lets a model credential's base URL be http://localhost (ADR-0026 §7). Never set
# this on a deployment — it is the one way a credential could be pointed at the host's loopback.
# WINDKEEL_ALLOW_LOCALHOST_MODEL_BASE_URL=1

# The checker's credential (ADR-0010: it must not be the maker's vendor). Legal to leave unset —
# the review and mapping stages then report themselves skipped rather than silently passing, and
# the worker warns about it at startup.
ANTHROPIC_API_KEY=
WINDKEEL_REVIEW_MODEL=

# ADR-0011 spend accounting. Token prices come from the model catalog for the run's own maker and
# checker models (ADR-0026 §9, packages/verification/src/providers/catalog.ts). Set these only to
# pin a rate: each one set wins over the catalog for its own field, for every run. A model the
# catalog does not know, with nothing pinned, is recorded *unpriced* — tokens and no dollar figure,
# and `windkeel run report` says the total is a lower bound. Unpriced is honest; zero was not (#242).
# WINDKEEL_USD_PER_INPUT_TOKEN=
# WINDKEEL_USD_PER_OUTPUT_TOKEN=
# WINDKEEL_USD_PER_CACHED_INPUT_TOKEN=

# The **checker's** pinned price per token. A different vendor from the maker by construction
# (ADR-0010), so a different rate — the variables above are the maker's and do not apply.
# WINDKEEL_CHECKER_USD_PER_INPUT_TOKEN=
# WINDKEEL_CHECKER_USD_PER_OUTPUT_TOKEN=

# What the spend cap charges an *unpriced* call's tokens at. The ledger keeps such a call unpriced;
# only the ADR-0011 rail estimates it, so a run on a model nobody priced still meets its cap.
# Default: the catalog's highest input and output rates. A cap met on an estimate says so.
# WINDKEEL_UNPRICED_USD_PER_INPUT_TOKEN=
# WINDKEEL_UNPRICED_USD_PER_OUTPUT_TOKEN=
WINDKEEL_USD_PER_CPU_MS=0.0000000128
WINDKEEL_USD_PER_EGRESS_BYTE=0.00000000015

# How often the ADR-0011 rails are re-checked *during* a streaming agent session. 30s overshoots
# the 7200s wall-clock cap by at most 0.4%; much coarser lets a runaway session burn tokens past
# its cap, which is the overnight-$1000 failure the rails exist to prevent.
WINDKEEL_RAILS_CHECK_INTERVAL_MS=30000

# How often the container runs ADR-0015's evidence retention sweep — superseded verification
# packages past the 90-day window are deleted from the object store and their rows tombstoned.
# Deliberately not the rails interval: retention is a daily-scale concern and the rails are a
# thirty-second one, and a deletion job sharing a knob with a safety check ends up tuned for the
# other one's failure mode. A sweep also runs once at startup, so a container restarted more
# often than this still sweeps; concurrent containers are serialised by a Postgres advisory
# lock, so a fleet-wide restart costs one sweep and not one per container.
#
# There is no value that turns it off — ADR-0015 is policy, not preference — and 0 is refused
# rather than read as "disabled", because setInterval(fn, 0) driving a delete job is a busy loop
# against the database and the bucket. Set a long interval if you want it to run rarely. With no
# S3_BUCKET the sweep reports itself *skipped, with the reason*, rather than sweeping nothing.
WINDKEEL_RETENTION_SWEEP_INTERVAL_MS=86400000

# How long a maker/verifier workspace may live. The backstop against a leaked sandbox when a
# container dies holding one: a SandboxHandle cannot be re-attached from a new process, so
# expires_at is what stops it billing forever.
WINDKEEL_WORKSPACE_TTL_MS=14400000

# The git host candidate branches are pushed to (ADR-0014 §2/§3). Added to the execution-phase
# egress allowlist for the push command only.
WINDKEEL_GIT_HOST=github.com
WINDKEEL_GIT_AUTHOR_NAME=Windkeel Factory
WINDKEEL_GIT_AUTHOR_EMAIL=factory@windkeel.invalid

# Recorded on every VerificationRun, so a stored verdict says which policy produced it.
WINDKEEL_POLICY_VERSION=v0

# The Codex CLI the container drives (ADR-0006). The binary is resolved *inside the sandbox*,
# not in this container: it ships preinstalled in Vercel Sandbox's universal image. The one
# exception is ADR-0016 local mode (no VERCEL_* credentials), where the "sandbox" is a temp
# directory on this host — there the worker refuses to start unless codex is on the host PATH.
# The version is a *check*, not an install: the adapter refuses to drive a CLI whose JSONL
# schema it has never seen, and records the version it did drive. Drift tolerance downgrades a
# mismatch to a diagnostic — an image bump then becomes visible rather than an outage.
WINDKEEL_CODEX_BINARY=codex
WINDKEEL_CODEX_VERSION=
WINDKEEL_ALLOW_CODEX_VERSION_DRIFT=false
# ADR-0027 §7.2: `pinned` installs the run's pinned harness when the sandbox image ships another.
WINDKEEL_HARNESS_INSTALL=verify

# The account audit log (#393, ADR-0030). How long events are kept when an account sets no
# retention of its own: 30 to 3650 days, default 90.
WINDKEEL_AUDIT_RETENTION_DAYS=
# Optional SIEM sink: the hourly sweep POSTs new audit events here, HMAC-signed with the secret
# (x-windkeel-signature: sha256=<hex of "<timestamp>.<body>">), at least once. Both or neither.
WINDKEEL_AUDIT_WEBHOOK_URL=
WINDKEEL_AUDIT_WEBHOOK_SECRET=
# The one header the deployment's proxy writes the client's address into, for the audit log and an
# account's IP allowlist. Default x-vercel-forwarded-for; never a header clients write unchecked.
WINDKEEL_CLIENT_IP_HEADER=

# ---------------------------------------------------------------------------------------------
# Intake integrations (#389). Slack, Linear and Jira tokens come from Vercel Connect (ADR-0025);
# each value is that connector's uid. Unset = that integration is off, never an error at boot.
# See docs/integrations.md.
WINDKEEL_CONNECT_SLACK=
WINDKEEL_CONNECT_LINEAR=
WINDKEEL_CONNECT_JIRA=
# Sentry (#389, ADR-0034). Connect does not carry Sentry, so WINDKEEL_CONNECT_SENTRY only switches the
# post-back on (any non-empty value, e.g. `sealed`; set it on the flow function). The Sentry token
# itself is stored sealed, like BYOK keys (needs the WINDKEEL_SECRET_* pair) — never put it here.
# WINDKEEL_SENTRY_CLIENT_SECRET is the Sentry integration's client secret, which verifies
# POST /api/intake/sentry (ingress); unset = every Sentry delivery is a 503.
WINDKEEL_CONNECT_SENTRY=
WINDKEEL_SENTRY_CLIENT_SECRET=

# --- Billing, budgets and self-serve signup (ADR-0037, ADR-0038, #394) ----------------------
# Who bills metered usage: `fake` (the default — in memory, no network, ADR-0016) or `stripe`.
# `stripe` needs the STRIPE_* variables below (the keys, the meter, and the seven plan and top-up
# prices); `windkeel-admin doctor` and /api/preflight fail by name
# when one is missing, and the API then builds no provider rather than falling back to the fake.
WINDKEEL_BILLING_PROVIDER=fake
# Use Stripe *test mode* keys (sk_test_…) everywhere except production.
STRIPE_SECRET_KEY=
# Verifies Stripe's webhook signatures on POST /v1/billing/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# TEST-ONLY. The fake provider's webhook signing secret. Unset (the default), the fake accepts no
# webhooks: POST /v1/billing/webhooks/fake answers 503. Never set this on a deployment people use —
# anyone who knows it can mark an account paid.
# WINDKEEL_FAKE_BILLING_WEBHOOK_SECRET=
# The Stripe meter usage is reported to. Usage is sent in micro-USD (integers), so price the meter
# at US$0.000001 per unit.
STRIPE_METER_EVENT_NAME=windkeel_usage
# Required with WINDKEEL_BILLING_PROVIDER=stripe (#439): the metered price, on the meter above, that
# overage (ADR-0040) and pay-as-you-go usage (ADR-0037) are invoiced on. Every plan checkout adds it to
# the subscription; a checkout with no plan subscribes to it alone.
STRIPE_PRICE_ID=

# Credit plans and top-ups (ADR-0040, #431). 1 credit = US$0.01. Compute is 2 credits per
# sandbox-minute of wall clock (maker and verifier, rounded up to the second once per run); AI on Windkeel's key is at cost; a
# role on the organization's own key pays compute only. Plans renew monthly and their credits reset
# each period (no rollover); top-ups expire 12 months after purchase. Spend order: plan credits,
# then top-ups (oldest expiry first), then overage — which is off unless an admin turns it on with a
# monthly cap. Required with WINDKEEL_BILLING_PROVIDER=stripe; the fake uses price_fake_<plan> ids.
#   Starter $20 → 2,000 credits · Pro $50 → 5,250 · Team $100 → 11,000 · Scale $250 → 30,000
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_SCALE=
#   One-time packs, no bonus: $10 → 1,000 credits · $25 → 2,500 · $50 → 5,000
STRIPE_PRICE_TOPUP_10=
STRIPE_PRICE_TOPUP_25=
STRIPE_PRICE_TOPUP_50=

# The price knobs (ADR-0037 §2), all read from the cost ledger. Two plans:
#   BYOK     — the organization's own model key: billed the compute fee only.
#   Managed  — Windkeel's models: billed AI cost + the compute fee.
# Spend on the organization's own key is never billed; unpriced calls are never invoiced (they count
# toward the budget at the conservative estimate). Verification is metered like everything else and
# is never waived. Defaults are pass-through: multipliers 1, fee 0.
#
# AI cost = model spend on Windkeel's key × this.
WINDKEEL_BILLING_AI_MULTIPLIER=1
# Compute fee = sandbox spend (maker and verifier sandbox time) × this ...
WINDKEEL_BILLING_COMPUTE_MULTIPLIER=1
# ... plus this much per verification run that reaches a verdict (verification time).
WINDKEEL_BILLING_VERIFICATION_FEE_USD=0

# Invite-only self-serve signup (ADR-0038). Unset or 0: single-tenant (ADR-0001's shape). `invite`
# (or 1): a signed-in person with an invite code from `windkeel-admin signup-invite` can create their
# own account and organization. There is no open mode.
WINDKEEL_SELF_SERVE_SIGNUP=
# A new self-serve account starts on credits with a one-time trial of 500 credits, no card
# (ADR-0040; this replaced WINDKEEL_TRIAL_CREDIT_USD).
# The GitHub App's URL slug, for the welcome wizard's install link (docs/github-app.md §7).
WINDKEEL_GITHUB_APP_SLUG=

# ---------------------------------------------------------------------------------------------
# Batches (#391, ADR-0036). Both optional; unset (or anything but a positive whole number) means
# the default shown. The org limit applies only to organizations whose max_concurrent_runs is null.
# WINDKEEL_BATCH_MAX_ITEMS=200
# WINDKEEL_DEFAULT_ORG_MAX_CONCURRENT_RUNS=10
